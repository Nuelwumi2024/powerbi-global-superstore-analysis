// ============================================================
// Atlas Global Retail - Profitability Analysis: DAX
// Every table, column and measure below is used by the four report pages.
//
// Tables: orders (fact), customers, products, returns, targets, Markets, DateTable
//
// Relationships (one-to-many, single direction):
//   customers[CustomerID] -> orders[CustomerID]
//   products[ProductID]   -> orders[ProductID]
//   DateTable[Date]       -> orders[OrderDate]
//   Markets[Market]       -> customers[Market]
//   returns[OrderID]      -> linked to orders by OrderID (return reasons)
//   targets has no relationship: the target measures match it with TREATAS
// ============================================================

// ---------- Calculated tables ----------
DateTable =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 1, 1 ), MAX ( orders[OrderDate] ) ),   // stops at the last order date
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ),
    "Month No", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "yyyy-MM" )
)

Markets = DISTINCT ( customers[Market] )

// ---------- Calculated columns (orders) ----------
Ship Days = DATEDIFF ( orders[OrderDate], orders[ShipDate], DAY )

Discount Band =
SWITCH (
    TRUE (),
    orders[Discount] = 0, "No Discount",
    orders[Discount] <= 0.1, "Low Discount",
    orders[Discount] <= 0.2, "Medium Discount",
    "High Discount"
)

Heavy Discount Sales (30%+) = IF ( orders[Discount] >= 0.3, orders[Sales], 0 )

// ---------- Core KPIs (page 1 cards) ----------
Total Sales = SUM ( orders[Sales] )
Total Profit = SUM ( orders[Profit] )
Profit Margin % = DIVIDE ( [Total Profit], [Total Sales] )
Orders = DISTINCTCOUNT ( orders[OrderID] )
Customers = DISTINCTCOUNT ( orders[CustomerID] )
AOV = DIVIDE ( [Total Sales], [Orders] )
Units Sold = SUM ( orders[Quantity] )

// ---------- Targets (page 1: sales vs target chart and profit gauge) ----------
Sales Target =
CALCULATE (
    SUM ( targets[SalesTarget] ),
    TREATAS ( VALUES ( DateTable[Year] ), targets[Year] ),
    TREATAS ( VALUES ( customers[Market] ), targets[Market] )
)

Profit Target =
CALCULATE (
    SUM ( targets[ProfitTarget] ),
    TREATAS ( VALUES ( DateTable[Year] ), targets[Year] ),
    TREATAS ( VALUES ( customers[Market] ), targets[Market] )
)

Gauge Max = [Profit Target] * 1.2

// ---------- Discount & loss analysis (page 3) ----------
Avg Discount % = AVERAGE ( orders[Discount] )

Heavy Discount Profit = CALCULATE ( [Total Profit], orders[Discount] >= 0.3 )

Loss-Making Share % =
DIVIDE ( CALCULATE ( COUNTROWS ( orders ), orders[Profit] < 0 ), COUNTROWS ( orders ) )

// ---------- Operations (page 4) ----------
// Avg Ship Days: drag orders[Ship Days] into a visual and set it to Average.
// Return orders by reason: Count of the Order ID column in returns, split by ReturnReason.
